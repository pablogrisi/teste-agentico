// Schema Prisma da LicIA Analisadora.
//
// TSD-001 (fundação técnica) NÃO define nenhuma tabela de domínio.
// As entidades `analise`, `requisito` e `avaliacao_requisito` descritas no
// SDD §8 entram nos ciclos dos respectivos RFs, cada uma na sua TSD.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

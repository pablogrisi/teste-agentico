// Schema Prisma da LicIA Analisadora.
//
// TSD-001 (fundação) não definiu tabela de domínio.
// TSD-003 (RF-006) adiciona `requisito` — a base fixa de verificação.
// TSD-004 (RF-001/004/018) adiciona `analise`.
// `avaliacao_requisito` (SDD §8) entra no ciclo do RF-007.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Item da base fixa de verificação (RF-006).
///
/// Regra de imutabilidade: uma vez publicado, os campos `titulo`, `descricao`,
/// a referência normativa e `obrigatorio` NÃO mudam. Se a regra normativa
/// muda, cria-se um novo requisito (novo `codigo`) e o antigo recebe
/// `ativo = false`. Só `ordem` e `ativo` são operacionais/mutáveis.
/// Não há coluna de versão: cada parecer referencia o requisito específico
/// avaliado, o que já serve de snapshot histórico.
model Requisito {
  id          String   @id @default(uuid()) @db.Uuid
  codigo      String   @unique
  /// Área de verificação. Campo livre (NÃO enum): o vocabulário deve crescer.
  /// A importação valida contra a allowlist em `src/requisitos/areas.ts`.
  area        String
  titulo      String
  descricao   String
  obrigatorio Boolean  @default(true)
  ordem       Int
  ativo       Boolean  @default(true)

  // Referência normativa estruturada (todos opcionais) — evita parsing de texto.
  normaLei       String? @map("norma_lei")
  normaArtigo    String? @map("norma_artigo")
  normaInciso    String? @map("norma_inciso")
  normaParagrafo String? @map("norma_paragrafo")
  normaAlinea    String? @map("norma_alinea")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([area, ordem])
  @@map("requisito")
}

/// Uma análise de conformidade de um processo licitatório (RF-001/004/018).
///
/// `status` é uma string validada em código (`src/analises/status-analise.ts`),
/// não um enum de banco — a máquina de estados é dirigida pela aplicação.
/// Neste momento só `PENDENTE` é escrito; o worker (RF-005) avança a partir daí.
model Analise {
  id            String    @id @default(uuid()) @db.Uuid
  nup           String
  objeto        String
  analistaId    String    @map("analista_id")
  arquivoPdfRef String    @map("arquivo_pdf_ref")
  status        String    @default("PENDENTE")
  motivoErro    String?   @map("motivo_erro")
  iniciadaEm    DateTime  @default(now()) @map("iniciada_em")
  concluidaEm   DateTime? @map("concluida_em")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em")

  @@index([analistaId, iniciadaEm])
  @@map("analise")
}

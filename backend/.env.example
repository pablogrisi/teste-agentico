# Porta HTTP do serviço
PORT=3000
NODE_ENV=development

# Conexão com o PostgreSQL (o docker-compose sobe um em localhost:5432)
DATABASE_URL="postgresql://licia:licia@localhost:5432/licia?schema=public"

# Analista único e fixo do MVP (não há autenticação nesta versão — ver SDD §2/§9)
ANALISTA_ATUAL_ID="analista-mvp"
ANALISTA_ATUAL_NOME="Analista MVP"

# Adapter da capacidade de análise por IA: "stub" (padrão) ou "http" (ainda não implementado)
IA_ADAPTER=stub

# Diretório onde o adapter de filesystem grava os PDFs de entrada
ARMAZENAMENTO_PDF_DIR=./var/pdfs
